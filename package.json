{
  "name": "graphrag-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "GraphRAG - Grounded knowledge assistant with graph retrieval",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test:api": "npm run test --workspace=apps/api",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "keywords": [
    "graphrag",
    "neo4j",
    "knowledge-graph",
    "groq",
    "rag"
  ],
  "author": "Vansh Sharma",
  "license": "Apache-2.0"
}